{
  "name": "@cajax/axios-parallel-limit",
  "version": "1.1.1",
  "description": "Limit parallel requests in Axios",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "npm run build && node examples/server.js",
    "start": "node examples/server.js",
    "lint": "tsc --noEmit && eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" README.md",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "axios",
    "parallel",
    "limit",
    "request",
    "http",
    "https",
    "rest",
    "api"
  ],
  "author": "cajax",
  "bugs": {
    "url": "https://github.com/cajax/axios-parallel-limit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cajax/axios-parallel-limit.git"
  },
  "homepage": "https://github.com/cajax/axios-parallel-limit",
  "license": "MIT",
  "dependencies": {
    "@cajax/bulkhead-limit": "^0.1.0",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "publishConfig": {
    "access": "public"
  }
}
